# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/github_bot?schema=public

# Server Port
PORT=4000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Public API URL (Frontend consumption & OAuth callback)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public Webhook URL (Optional: your ngrok or cloudflared URL if receiving live webhooks from GitHub.com)
WEBHOOK_PUBLIC_URL=

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Webhook Signature Secret
GITHUB_WEBHOOK_SECRET=

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# Session / Cookie Secret (Minimum 32 characters)
SESSION_SECRET=

# Google Gemini 1.5 Flash API Key (Optional: for AI Issue/PR Triage & Summarization)
GEMINI_API_KEY=
