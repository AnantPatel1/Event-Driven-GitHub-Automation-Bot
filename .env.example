# ==============================================================================
# GitHub Automation Bot - Environment Variables Template
# Copy these variables into Vercel Project Settings (Settings -> Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# In production on Vercel, use a cloud PostgreSQL connection string:
# (e.g. from Neon.tech, Supabase, Railway, or Render Postgres)
# Example: postgresql://username:password@ep-cool-flower-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/github_bot?schema=public

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & URLS (Required)
# ------------------------------------------------------------------------------
NODE_ENV=production
# In Vercel, set this to your live production domain (no trailing slash):
APP_URL=https://your-app-name.vercel.app

# Optional: If testing webhooks locally with ngrok:
# WEBHOOK_PUBLIC_URL=https://your-tunnel.ngrok-free.dev

# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH APP CREDENTIALS (Required)
# ------------------------------------------------------------------------------
# Create an OAuth App in GitHub: Settings -> Developer settings -> OAuth Apps
# Set Homepage URL to: https://your-app-name.vercel.app
# Set Authorization callback URL to: https://your-app-name.vercel.app/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ------------------------------------------------------------------------------
# 4. GITHUB WEBHOOK SIGNATURE SECRET (Required)
# ------------------------------------------------------------------------------
# Used to verify HMAC-SHA256 signatures of incoming GitHub webhooks.
# Generate any random 32+ character string (e.g. openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=your_32_character_random_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. SESSION & SECURITY KEYS (Required)
# ------------------------------------------------------------------------------
# Random 32+ character secret used to sign session cookies
SESSION_SECRET=your_32_character_random_session_secret_here

# Random 32+ character secret used for AES-256-GCM encryption of Slack webhooks
ENCRYPTION_KEY=your_32_character_random_encryption_key_here

# ------------------------------------------------------------------------------
# 6. OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Flash API Key for AI Issue/PR Triage:
# (Get from https://aistudio.google.com/ - leave blank to use the built-in heuristic triage engine)
GEMINI_API_KEY=

# Global default Slack incoming webhook (optional):
SLACK_WEBHOOK_URL=
