# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/github_bot?schema=public

# Server Port
PORT=4000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Public API URL (Frontend consumption)
NEXT_PUBLIC_API_URL=http://localhost:4000

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Webhook Signature Secret
GITHUB_WEBHOOK_SECRET=

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# Session / Cookie Secret (Minimum 32 characters)
SESSION_SECRET=
